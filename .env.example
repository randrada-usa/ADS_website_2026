# Leave both empty for clearly labeled local demo mode.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Keep false while editing drafts; true switches the public site to published CMS content.
SANITY_SITE_CONTENT_ENABLED=false
# Server-only Viewer token for authenticated draft previews. Never use NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
